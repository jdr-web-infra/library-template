root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,css,scss,less,md,mdx,yml,yaml}]
quote_type = single

# Oxfmt proseWrap is preserve, so Markdown hard breaks stay.
[*.{md,mdx}]
trim_trailing_whitespace = false
