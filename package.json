{
  "name": "@jdr-web-infra/library-template",
  "version": "0.0.0",
  "homepage": "https://github.com/jdr-web-infra/library-template#readme",
  "bugs": {
    "url": "https://github.com/jdr-web-infra/library-template/issues"
  },
  "license": "MIT",
  "author": "Yongqi (Ari) He <heyq02@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdr-web-infra/library-template.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "release": "bumpp && vp pm publish",
    "test": "vp test"
  },
  "devDependencies": {
    "@liangmi/vp-config": "1.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "automd": "0.4.3",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
